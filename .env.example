# Copy to .env and fill in. .env is gitignored - never commit credentials.

# --- Option A: Vertex AI with Application Default Credentials (no key) -------
# Required when your organisation disallows API keys. Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
# The quota project matters: without it requests are attributed to a shared
# Google project and every model returns 404.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
# Gemini 3.x publisher models are served from 'global', NOT a regional
# endpoint - us-central1 returns 404 for gemini-3.5-flash.
GOOGLE_CLOUD_LOCATION=global

# --- Option B: Gemini API key -----------------------------------------------
# GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------

# Refuse simulated fallbacks. Use when recording the demo.
# DOCUMA_STRICT_MODE=true

# Gemma pre-flight triage. The -maas suffix is Model-as-a-Service, servable
# without deploying your own GPU endpoint.
DOCUMA_TRIAGE_MODEL=gemma-4-26b-a4b-it-maas
# DOCUMA_DISABLE_TRIAGE=true
