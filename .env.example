# Copy to .env and fill in. .env is gitignored - never commit a real key.
GEMINI_API_KEY=

# Your Google Cloud project id (Console > project selector).
GOOGLE_CLOUD_PROJECT=

# Uncomment to refuse simulated fallbacks - use this when recording the demo.
# DOCUMA_STRICT_MODE=true

# Gemma model for pre-flight triage; override if the default id is unavailable.
# DOCUMA_TRIAGE_MODEL=gemma-3-27b-it
